# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Origin allowed to call this API (the frontend dev/prod URL)
CLIENT_ORIGIN=http://localhost:5173

# Admin panel auth
# Generate a bcrypt hash of your chosen password, e.g.:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH="$2b$10$replace.with.a.real.bcrypt.hash"

# Random secret used to sign admin session JWTs, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
